# Generated by install.sh. The Splunk OpenTelemetry Collector reads this file.
# HEC token and URL come from the collector environment, not from this file.

extensions:
  health_check:
    endpoint: 127.0.0.1:13133

receivers:
  otlp:
    protocols:
      grpc:
        endpoint: "__OTLP_GRPC_LISTEN__"
      http:
        endpoint: "__OTLP_HTTP_LISTEN__"
  filelog/gnmic:
    include:
      - "__GNMIC_EVENTS_FILE__"
    start_at: end
    poll_interval: 1s
    max_log_size: 4MiB
    operators:
      - type: json_parser
        parse_from: body
  filelog/runtime:
    include:
      - "__GNMIC_RUNTIME_LOG__"
    start_at: end
    poll_interval: 1s
    max_log_size: 1MiB
  # gnmic internal metrics (target up, connection state, subscribe counters)
  # and this collector's own export counters.
  prometheus/stack:
    config:
      scrape_configs:
        - job_name: gnmic
          scrape_interval: 15s
          static_configs:
            - targets: ["127.0.0.1:7890"]
        - job_name: otel-collector
          scrape_interval: 15s
          static_configs:
            - targets: ["127.0.0.1:8888"]

processors:
  memory_limiter:
    check_interval: 2s
    limit_mib: 512
  batch:
    timeout: 5s
    send_batch_size: 1000

exporters:
  splunk_hec/metrics:
    token: ${SPLUNK_HEC_TOKEN}
    endpoint: ${SPLUNK_HEC_URL}
    index: "__SPLUNK_HEC_METRICS_INDEX__"
    source: gnmic
    sourcetype: "__SPLUNK_HEC_METRICS_SOURCETYPE__"
    timeout: 10s
    tls:
      insecure_skip_verify: __SPLUNK_HEC_TLS_SKIP_VERIFY__
      ca_file: "__SPLUNK_HEC_CA_FILE__"
  splunk_hec/events:
    token: ${SPLUNK_HEC_TOKEN}
    endpoint: ${SPLUNK_HEC_URL}
    index: "__SPLUNK_HEC_EVENTS_INDEX__"
    source: gnmic
    sourcetype: "__SPLUNK_HEC_EVENTS_SOURCETYPE__"
    timeout: 10s
    tls:
      insecure_skip_verify: __SPLUNK_HEC_TLS_SKIP_VERIFY__
      ca_file: "__SPLUNK_HEC_CA_FILE__"
  splunk_hec/ops:
    token: ${SPLUNK_HEC_TOKEN}
    endpoint: ${SPLUNK_HEC_URL}
    index: "__SPLUNK_HEC_OPS_INDEX__"
    source: gnmic
    sourcetype: "__SPLUNK_HEC_RUNTIME_SOURCETYPE__"
    timeout: 10s
    tls:
      insecure_skip_verify: __SPLUNK_HEC_TLS_SKIP_VERIFY__
      ca_file: "__SPLUNK_HEC_CA_FILE__"

  splunk_hec/stack:
    token: ${SPLUNK_HEC_TOKEN}
    endpoint: ${SPLUNK_HEC_URL}
    index: "__SPLUNK_HEC_METRICS_INDEX__"
    source: gnmi-stack
    sourcetype: "__SPLUNK_HEC_METRICS_SOURCETYPE__"
    timeout: 10s
    tls:
      insecure_skip_verify: __SPLUNK_HEC_TLS_SKIP_VERIFY__
      ca_file: "__SPLUNK_HEC_CA_FILE__"

service:
  extensions: [health_check]
  telemetry:
    metrics:
      level: normal
      readers:
        - pull:
            exporter:
              prometheus:
                host: 127.0.0.1
                port: 8888
  pipelines:
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, batch]
      exporters: [splunk_hec/metrics]
    metrics/stack:
      receivers: [prometheus/stack]
      processors: [memory_limiter, batch]
      exporters: [splunk_hec/stack]
    logs:
      receivers: [filelog/gnmic]
      processors: [memory_limiter, batch]
      exporters: [splunk_hec/events]
    logs/runtime:
      receivers: [filelog/runtime]
      processors: [memory_limiter, batch]
      exporters: [splunk_hec/ops]
