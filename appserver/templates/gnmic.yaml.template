# Generated by install.sh. Re-running the installer overwrites this file.
# Device addresses live in the targets file, which the installer appends below.

username: "__GNMI_USERNAME__"
password: "__GNMI_PASSWORD__"
timeout: 10s
retry: 30s
encoding: json_ietf
insecure: __GNMI_INSECURE__
skip-verify: __GNMI_SKIP_VERIFY__
tls-ca: "__GNMI_TLS_CA__"
max-msg-size: 16777216
# gnmic writes no log unless log is true. JSON lines go to the runtime log,
# which the collector sends to Splunk as the runtime sourcetype.
log: true
log-format: json

# Local API and internal metrics: gnmic_target_up, gnmic_target_connection_state,
# and the subscribe counters. The collector scrapes /metrics into the metrics index.
api-server:
  address: 127.0.0.1:7890
  enable-metrics: true
  healthz-disable-logging: true

subscriptions:
  # Each name is its own gNMI Subscribe RPC. An unsupported path fails only
  # that subscription; the others keep streaming.
  #
  # interface-counters through bgp are OpenConfig. Cisco, Junos, Arista,
  # Nokia SR OS, and Huawei gNMI accept those paths.
  # srl-* are Nokia SR Linux native YANG. SR Linux rejects the OpenConfig
  # names, including /system/memory/state and /interfaces/interface.
  interface-counters:
    paths:
      - /interfaces/interface/state/counters
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  interface-status:
    paths:
      - /interfaces/interface/state/oper-status
      - /interfaces/interface/state/admin-status
      - /interfaces/interface/state/name
      - /interfaces/interface/ethernet/state/negotiated-port-speed
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  cpu:
    paths:
      - /components/component/cpu/utilization/state
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  memory:
    paths:
      - /system/memory/state
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  lldp:
    paths:
      - /lldp/interfaces/interface/neighbors/neighbor/state
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  bgp:
    paths:
      - /network-instances/network-instance/protocols/protocol/bgp/neighbors/neighbor/state/session-state
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  srl-interface-counters:
    paths:
      - /interface/statistics
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  srl-interface-status:
    paths:
      - /interface/oper-state
      - /interface/admin-state
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  srl-cpu:
    paths:
      - /platform/control/cpu
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  srl-memory:
    paths:
      - /platform/control/memory
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  srl-lldp:
    paths:
      - /system/lldp
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__
  srl-bgp:
    paths:
      - /network-instance/protocols/bgp
    mode: stream
    stream-mode: sample
    encoding: json_ietf
    sample-interval: __GNMI_SAMPLE_INTERVAL__

outputs:
  otlp:
    type: otlp
    endpoint: "__OTLP_ENDPOINT__"
    protocol: grpc
    timeout: 10s
    batch-size: 1000
    interval: 5s
    strings-as-attributes: true
    append-subscription-name: true
    strip-leading-underscore: true
    counter-patterns:
      - ".*octets.*"
      - ".*pkts.*"
      - ".*packets.*"
      - ".*errors.*"
      - ".*discards.*"
    resource-attributes:
      telemetry.source: gnmic
      service.name: gnmic
  events:
    type: file
    filename: "__GNMIC_EVENTS_FILE__"
    format: event
    split-events: true
    rotation:
      max-size: 100
      max-age: 7
      max-backups: 5
      compress: true
